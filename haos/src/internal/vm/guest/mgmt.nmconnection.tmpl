[connection]
id=HAOS LPK management
uuid=4b54a2c0-5cbd-4b3d-89dd-e04404ee0202
type=ethernet
interface-name=enp0s2
autoconnect-priority=999

[ipv4]
method=manual
address1={{.GuestCIDR}}
never-default=true
route1={{.AppSubnet}},{{.Gateway}}
{{if .HostRoute -}}
route2={{.HostRoute}},{{.Gateway}}
{{end}}

[ipv6]
{{if .OIDC -}}
method=manual
address1={{.ManagementIPv6}}15/64
never-default=true
route1=fc03:1136:3800::/40,{{.ManagementIPv6}}2
route1_options=src={{.ManagementIPv6}}15
{{else -}}
method=disabled
{{end -}}
